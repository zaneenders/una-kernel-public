{
  "version": 3,
  "configurePresets": [
    {
      "name": "firmware",
      "displayName": "UNA Watch firmware (C, C++, Embedded Swift)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cmake",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "firmware",
      "configurePreset": "firmware",
      "jobs": 8
    }
  ]
}
